+// The tap destination, taken from the content state's own `deepLink` field.
+//
+// Upstream only knows the URL passed to `LiveActivityFactory.start(props:url:)`, which it stores
+// once, keyed by the activity's *name*. That is wrong for us three times over: `update()` takes no
+// url, so the link can never follow the content; a push-started activity never calls `start` at all
+// and so has no stored URL; and the stored URL was applied only inside the `dynamicIsland:` closure,
+// so the Lock Screen banner — the surface this feature is actually about — had no link whatsoever,
+// and tapping it dumped the user wherever the app happened to be.
+//
+// The props payload is carried on every frame, from every source, and already contains `deepLink`
+// (`BundlesActivityContentState`, docs/live-activity-contract.md), so deriving the URL from it
+// closes all three holes without adding any API. Falls back to the stored URL, so an activity
+// started with `start(props:url:)` and no `deepLink` in its props behaves exactly as before.
+func getLiveActivityUrl(forState state: LiveActivityAttributes.ContentState) -> URL? {
+  if let data = state.props.data(using: .utf8),
+     let props = try? JSONSerialization.jsonObject(with: data, options: []) as? [String: Any],
+     let deepLink = props["deepLink"] as? String,
+     !deepLink.isEmpty,
+     let url = URL(string: deepLink) {
+    return url
+  }
+  return getLiveActivityUrl(forName: state.name)
+}
