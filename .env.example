# Copy to `.env` (which is gitignored): `cp .env.example .env`
#
# Only EXPO_PUBLIC_* values belong here — Expo inlines them into the client bundle, so they
# are NOT secret. The Supabase publishable key is public by design; row-level security, not
# key secrecy, is what protects the data. Never put a service_role key or DB password here.

EXPO_PUBLIC_SUPABASE_URL=https://agnslitokcyvkboiklwn.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tPH6p4JpADofyZHyx3tcvw_5l9PuvWo
