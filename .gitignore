# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Supabase management access token (never commit)
.supabase-access-token

# Spotify client secret (never commit)
.spotify-client-secret

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Release artifacts: .xcarchive, exported .ipa, generated ExportOptions.plist
/build

# App Store Connect issuer id (an identifier, not a secret, but kept local like the team id)
.asc-issuer-id

# Poller shared secret (never commit)
.poll-secret

# Supabase CLI temp
supabase/.temp/

# Apple Team ID (not secret, but keep local)
.apple-team-id

# APNs auth key (never commit)
.apns-key.p8

# Generated by xcodegen from tools/widget-shot/project.yml
tools/widget-shot/WidgetShot.xcodeproj/

# Claude Code session transcript dumps (kept locally, not part of the repo)
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*-bash*.txt
